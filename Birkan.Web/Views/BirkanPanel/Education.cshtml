@model BirkanSection<BirkanEducation>
@{
    ViewData["Title"] = "Eğitim";
    ViewData["Lead"] = "Okullar sitede burada sıralandığı düzende, soldan sağa zaman çizelgesinde görünür.";

    async Task Item(BirkanEducation e)
    {
        <article class="birkan-item" data-birkan-item>
            <partial name="_BirkanItemControls" model="@(string.IsNullOrEmpty(e.School) ? "Yeni okul" : e.School)" />
            <div class="birkan-item-body birkan-item-with-media">
                @BirkanField.Image("Okul logosu", "Logo", e.Logo, "logo", rel: true)
                <div class="birkan-grid-2">
                    <div data-birkan-title-source>@BirkanField.Text("Okul", "School", e.School, rel: true)</div>
                    @BirkanField.Text("Derece", "Degree", e.Degree, rel: true, placeholder: "Lise, Önlisans, Lisans, Yüksek Lisans…")
                    @BirkanField.Text("Fakülte / yüksekokul", "Faculty", e.Faculty, rel: true)
                    @BirkanField.Text("Bölüm", "Department", e.Department, rel: true)
                    @BirkanField.Text("Yıllar", "Years", e.Years, rel: true, placeholder: "2012 — 2016", hint: "Boş bırakılabilir.")
                </div>
            </div>
        </article>
    }
}

<form method="post" asp-action="Education" class="birkan-form" data-birkan-form>
    <section class="birkan-card">
        <header class="birkan-card-head"><h3>Bölüm</h3></header>
        <div class="birkan-grid-2">
            @BirkanField.Text("Başlık", "Title", Model.Title)
            @BirkanField.Text("Alt açıklama", "Description", Model.Description, hint: "Boş bırakılırsa sitede görünmez.")
        </div>
    </section>

    <section class="birkan-card">
        <header class="birkan-card-head"><h3>Okullar</h3></header>
        <div class="birkan-repeater" data-birkan-repeater="Items">
            <div class="birkan-repeater-list" data-birkan-list>
                @foreach (var e in Model.Items) { await Item(e); }
            </div>
            <template data-birkan-template>@{ await Item(new BirkanEducation()); }</template>
            <button type="button" class="birkan-btn birkan-btn-ghost" data-birkan-add>+ Okul ekle</button>
        </div>
    </section>

    <partial name="_BirkanSaveBar" />
</form>
