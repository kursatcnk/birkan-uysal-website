@model BirkanPasswordForm
@{
    ViewData["Title"] = "Şifre";
    ViewData["Lead"] = "Panel şifresini değiştirin. Yeni şifre en az 8 karakter olmalı.";
}

<form method="post" asp-action="Password" class="birkan-form birkan-form-narrow">
    <section class="birkan-card">
        <label class="birkan-field">
            <span class="birkan-field-label">Mevcut şifre</span>
            <input class="birkan-input" type="password" name="Current" autocomplete="current-password" required />
        </label>
        <label class="birkan-field">
            <span class="birkan-field-label">Yeni şifre</span>
            <input class="birkan-input" type="password" name="New" autocomplete="new-password" minlength="8" required />
        </label>
        <label class="birkan-field">
            <span class="birkan-field-label">Yeni şifre (tekrar)</span>
            <input class="birkan-input" type="password" name="Repeat" autocomplete="new-password" minlength="8" required />
        </label>
        <button type="submit" class="birkan-btn birkan-btn-primary">Şifreyi değiştir</button>
    </section>
</form>
