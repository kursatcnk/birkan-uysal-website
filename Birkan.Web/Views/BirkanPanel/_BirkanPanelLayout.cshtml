@{
    var current = ViewContext.RouteData.Values["action"]?.ToString();
    var nav = new (string Action, string Label, string Group)[]
    {
        ("Index", "Karargâh", "Panel"),
        ("General", "Genel ve Giriş", "İçerik"),
        ("About", "Hakkımda", "İçerik"),
        ("Education", "Eğitim", "İçerik"),
        ("Experience", "Deneyim", "İçerik"),
        ("Skills", "Yetenekler", "İçerik"),
        ("Projects", "Projeler", "İçerik"),
        ("Contact", "İletişim", "İçerik"),
        ("Backups", "Yedekler", "Ayarlar"),
        ("Password", "Şifre", "Ayarlar")
    };
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · Birkan Panel</title>
    <link rel="icon" href="/birkan-media/birkan-mark.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/birkan-panel/birkan-panel.css" asp-append-version="true" />
</head>
<body class="birkan-panel">
<div class="birkan-panel-shell">
    <aside class="birkan-sidebar" id="birkan-sidebar">
        <a class="birkan-sidebar-brand" asp-action="Index">
            <span class="birkan-sidebar-crescent" aria-hidden="true">
                <svg viewBox="0 0 40 40"><circle cx="16" cy="20" r="10" fill="currentColor" /><circle cx="18.6" cy="20" r="8" fill="var(--birkan-crescent-cut)" /><polygon fill="currentColor" points="22.6,20 25.7,18.91 25.78,15.63 27.77,18.24 30.92,17.3 29.05,20 30.92,22.7 27.77,21.76 25.78,24.38 25.7,21.09" /></svg>
            </span>
            <span>
                <strong>Birkan Uysal</strong>
                <small>Yönetim Paneli</small>
            </span>
        </a>

        <nav class="birkan-sidebar-nav">
            @foreach (var group in nav.GroupBy(n => n.Group))
            {
                <p class="birkan-sidebar-group">@group.Key</p>
                @foreach (var item in group)
                {
                    <a asp-action="@item.Action" class="@(current == item.Action ? "birkan-is-active" : "")">@item.Label</a>
                }
            }
        </nav>

        <div class="birkan-sidebar-foot">
            <img src="~/birkan-panel/img/birkan-panel-ataturk-imza.png" alt="Atatürk'ün imzası" class="birkan-sidebar-signature" />
            <p class="birkan-sidebar-year">Cumhuriyet'in @BirkanAtaturk.RepublicYear. yılı</p>
            <div class="birkan-sidebar-actions">
                <a href="/" target="_blank" class="birkan-btn birkan-btn-ghost-dark birkan-btn-sm">Siteyi aç</a>
                <form asp-action="Logout" method="post">
                    <button type="submit" class="birkan-btn birkan-btn-link-dark birkan-btn-sm">Çıkış</button>
                </form>
            </div>
        </div>
    </aside>

    <div class="birkan-main">
        <header class="birkan-topbar">
            <button type="button" class="birkan-topbar-menu" data-birkan-sidebar-toggle aria-label="Menü"><span></span><span></span></button>
            <h1 class="birkan-topbar-title">@ViewData["Title"]</h1>
            @if (ViewData["Lead"] is string lead)
            {
                <p class="birkan-topbar-lead">@lead</p>
            }
        </header>

        @if (TempData["Notice"] is string notice)
        {
            <div class="birkan-notice" role="status" data-birkan-notice>@notice</div>
        }
        @if (ViewData["Error"] is string error)
        {
            <div class="birkan-notice birkan-notice-error" role="alert">@error</div>
        }

        <main class="birkan-content">
            @RenderBody()
        </main>
    </div>
</div>

<form id="birkan-upload-token" hidden>@Html.AntiForgeryToken()</form>
<script src="~/birkan-panel/birkan-panel.js" asp-append-version="true"></script>
</body>
</html>
