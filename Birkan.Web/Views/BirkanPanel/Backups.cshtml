@model IReadOnlyList<FileInfo>
@{
    ViewData["Title"] = "Yedekler";
    ViewData["Lead"] = "Her kayıttan önce içeriğin bir kopyası alınır; son 30 kopya saklanır. Bir yedeği geri yüklemek siteyi o anki hâline döndürür.";
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

<section class="birkan-card">
    @if (Model.Count == 0)
    {
        <p class="birkan-empty">Henüz yedek yok. İlk kayıtta oluşacak.</p>
    }
    else
    {
        <ul class="birkan-backups">
            @foreach (var f in Model)
            {
                <li>
                    <span>
                        <strong>@f.LastWriteTime.ToString("d MMMM yyyy, HH:mm:ss", tr)</strong>
                        <span class="birkan-mono">@(f.Length / 1024) KB</span>
                    </span>
                    <form asp-action="Restore" method="post" data-birkan-confirm="Site bu yedeğe döndürülsün mü?">
                        <input type="hidden" name="name" value="@f.Name" />
                        <button type="submit" class="birkan-btn birkan-btn-ghost birkan-btn-sm">Geri yükle</button>
                    </form>
                </li>
            }
        </ul>
    }
</section>
