@model BirkanSection<BirkanSkill>
@{
    ViewData["Title"] = "Yetenekler";
    ViewData["Lead"] = "Araçlar sitede numaralı bir parça listesi olarak, burada sıralandığı düzende görünür.";

    async Task Item(BirkanSkill e)
    {
        <article class="birkan-item birkan-item-compact" data-birkan-item>
            <partial name="_BirkanItemControls" model="@(string.IsNullOrEmpty(e.Name) ? "Yeni yetenek" : e.Name)" />
            <div data-birkan-title-source>@BirkanField.Text("Ad", "Name", e.Name, rel: true)</div>
        </article>
    }
}

<form method="post" asp-action="Skills" class="birkan-form" data-birkan-form>
    <section class="birkan-card">
        <header class="birkan-card-head"><h3>Bölüm</h3></header>
        <div class="birkan-grid-2">
            @BirkanField.Text("Başlık", "Title", Model.Title)
            @BirkanField.Text("Açıklama", "Description", Model.Description)
        </div>
    </section>

    <section class="birkan-card">
        <header class="birkan-card-head"><h3>Araçlar</h3></header>
        <div class="birkan-repeater" data-birkan-repeater="Items">
            <div class="birkan-repeater-list birkan-repeater-grid" data-birkan-list>
                @foreach (var e in Model.Items) { await Item(e); }
            </div>
            <template data-birkan-template>@{ await Item(new BirkanSkill()); }</template>
            <button type="button" class="birkan-btn birkan-btn-ghost" data-birkan-add>+ Yetenek ekle</button>
        </div>
    </section>

    <partial name="_BirkanSaveBar" />
</form>
