@model BirkanLoginForm
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Giriş · Birkan Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="~/birkan-panel/img/birkan-panel-ataturk-1930.webp" />
    <link rel="stylesheet" href="~/birkan-panel/birkan-panel.css" asp-append-version="true" />
</head>
<body class="birkan-login">
<main class="birkan-login-shell">
    <figure class="birkan-login-portrait">
        <img src="~/birkan-panel/img/birkan-panel-ataturk-1930.webp" alt="Mustafa Kemal Atatürk, 1930" />
        <figcaption class="birkan-login-caption">
            <blockquote>“Hayatta en hakiki mürşit ilimdir.”</blockquote>
            <img src="~/birkan-panel/img/birkan-panel-ataturk-imza.png" alt="Atatürk'ün imzası" class="birkan-login-signature" />
            <span class="birkan-login-meta">Mustafa Kemal Atatürk · 1930</span>
        </figcaption>
    </figure>

    <section class="birkan-login-panel">
        <div class="birkan-login-top">
            <span class="birkan-login-mark">BU</span>
            <span class="birkan-mono">Cumhuriyet'in @BirkanAtaturk.RepublicYear. yılı</span>
        </div>

        <div class="birkan-login-form-wrap">
            <p class="birkan-mono birkan-login-kicker">Birkan Uysal · Yönetim Paneli</p>
            <h1 class="birkan-login-title">Giriş</h1>
            <p class="birkan-login-lead">Sitedeki her metni, görseli ve bölümü buradan yönetebilirsiniz.</p>

            @if (ViewData["Error"] is string error)
            {
                <div class="birkan-notice birkan-notice-error" role="alert">@error</div>
            }

            <form method="post" asp-action="Login" class="birkan-login-form">
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                <label class="birkan-field">
                    <span class="birkan-field-label">Kullanıcı adı</span>
                    <input class="birkan-input" name="Username" value="@Model.Username" autocomplete="username" autofocus required />
                </label>
                <label class="birkan-field">
                    <span class="birkan-field-label">Şifre</span>
                    <input class="birkan-input" type="password" name="Password" autocomplete="current-password" required />
                </label>
                <button type="submit" class="birkan-btn birkan-btn-primary birkan-btn-block">Giriş yap</button>
            </form>
        </div>

        <p class="birkan-login-foot birkan-mono">“Yurtta sulh, cihanda sulh.”</p>
    </section>
</main>
</body>
</html>
