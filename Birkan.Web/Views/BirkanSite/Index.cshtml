@model BirkanContent
@{
    var site = Model.Site;
    var hasExperience = Model.Experience.Items.Count > 0;

    var sections = new List<(string Id, string Label)>
    {
        ("birkan-about", site.Nav.About),
        ("birkan-education", site.Nav.Education)
    };
    if (hasExperience) sections.Add(("birkan-experience", site.Nav.Experience));
    sections.Add(("birkan-skills", site.Nav.Skills));
    sections.Add(("birkan-projects", site.Nav.Projects));
    sections.Add(("birkan-contact", site.Nav.Contact));

    var heroPhoto = BirkanSafe.MediaPath(Model.Hero.Photo);
    var aboutPhoto = BirkanSafe.MediaPath(Model.About.Photo);
    var nameParts = Model.Hero.Name.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
    var location = Model.Contact.Items.FirstOrDefault(c => c.Type == "location")?.Value;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@site.Title</title>
    <meta name="description" content="@site.MetaDescription" />
    <meta name="author" content="@site.Name" />
    <meta property="og:title" content="@site.Title" />
    <meta property="og:description" content="@site.MetaDescription" />
    <meta property="og:image" content="@heroPhoto" />
    <meta name="theme-color" content="#121314" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/birkan-site.css" asp-append-version="true" />
    <script>
        // Hareket azaltma tercihi yoksa animasyon sınıfı ekleniyor. Kütüphaneler yüklenemezse
        // açılış perdesi 4 saniye sonra kendiliğinden kalkıyor; içerik hiçbir durumda gizli kalmıyor.
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.documentElement.classList.add("birkan-anim");
            setTimeout(function () { document.documentElement.classList.add("birkan-intro-done"); }, 4000);
        }
    </script>
</head>
<body>

<div class="birkan-intro" aria-hidden="true">
    <div class="birkan-intro-name">@site.Name</div>
    <div class="birkan-intro-role">@site.Role</div>
</div>
<div class="birkan-progress" aria-hidden="true"></div>

<header class="birkan-navbar" id="birkan-navbar">
    <div class="birkan-shell birkan-navbar-inner">
        <a class="birkan-navbar-name" href="#birkan-home">@site.Name</a>
        <nav class="birkan-navbar-links" id="birkan-navbar-links" aria-label="Menü">
            <a href="#birkan-home" data-birkan-spy="birkan-home">@site.Nav.Home</a>
            @foreach (var s in sections)
            {
                <a href="#@s.Id" data-birkan-spy="@s.Id">@s.Label</a>
            }
        </nav>
        <button class="birkan-navbar-toggle" id="birkan-navbar-toggle" type="button" aria-controls="birkan-navbar-links" aria-expanded="false" aria-label="Menü">
            <span></span><span></span>
        </button>
    </div>
</header>

<main>
    <section class="birkan-hero" id="birkan-home">
        <div class="birkan-shell birkan-hero-grid">
            <div class="birkan-hero-copy">
                <p class="birkan-hero-meta">
                    <span>@site.Role</span>
                    @if (!string.IsNullOrEmpty(location))
                    {
                        <span>@location</span>
                    }
                </p>
                <h1 class="birkan-hero-name">
                    @foreach (var part in nameParts)
                    {
                        <span>@part</span>
                    }
                </h1>
                <p class="birkan-hero-intro">@Model.Hero.Text</p>
                <div class="birkan-hero-actions">
                    <a class="birkan-btn" href="#birkan-contact">@site.Nav.Contact</a>
                    @foreach (var social in Model.Hero.Socials)
                    {
                        <a class="birkan-link" href="@BirkanSafe.Url(social.Url)" target="_blank" rel="noopener noreferrer">@social.Label <span aria-hidden="true">↗</span></a>
                    }
                </div>
            </div>

            <div class="birkan-hero-visual">
                <figure class="birkan-portrait birkan-hero-portrait">
                    <img src="@heroPhoto" alt="@Model.Hero.Name" width="420" height="525" fetchpriority="high" />
                </figure>
            </div>
        </div>
    </section>

    <section class="birkan-section" id="birkan-about">
        <div class="birkan-shell">
            <div class="birkan-about-top" data-birkan-reveal>
                <h2 class="birkan-title" data-birkan-split>@Model.About.Title</h2>
                <p class="birkan-about-lead" data-birkan-split>@Model.About.Greeting <em>@Model.About.GreetingName</em></p>
            </div>
            <div class="birkan-about-grid">
                <div class="birkan-about-text" data-birkan-reveal>
                    <p>@Model.About.Bio</p>
                    @if (!string.IsNullOrEmpty(aboutPhoto) && aboutPhoto != heroPhoto)
                    {
                        <figure class="birkan-portrait birkan-portrait-small">
                            <img src="@aboutPhoto" alt="@site.Name" loading="lazy" />
                            <figcaption>@Model.About.BadgeTop @Model.About.BadgeBottom</figcaption>
                        </figure>
                    }
                </div>
                <div class="birkan-expertise" data-birkan-reveal>
                    <h3>@Model.About.ExpertiseTitle</h3>
                    <p class="birkan-muted">@Model.About.ExpertiseDescription</p>
                    <ul>
                        @foreach (var item in Model.About.Expertise)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="birkan-section birkan-section-tint" id="birkan-education">
        <div class="birkan-shell">
            <div class="birkan-head" data-birkan-reveal>
                <h2 class="birkan-title" data-birkan-split>@Model.Education.Title</h2>
                @if (!string.IsNullOrEmpty(Model.Education.Description))
                {
                    <p class="birkan-muted">@Model.Education.Description</p>
                }
            </div>
            <ol class="birkan-timeline" data-birkan-stagger>
                @foreach (var item in Model.Education.Items)
                {
                    <li data-birkan-reveal>
                        <p class="birkan-timeline-degree">
                            @item.Degree
                            @if (!string.IsNullOrEmpty(item.Years))
                            {
                                <span>@item.Years</span>
                            }
                        </p>
                        @if (!string.IsNullOrEmpty(BirkanSafe.MediaPath(item.Logo)))
                        {
                            <img class="birkan-timeline-logo" src="@BirkanSafe.MediaPath(item.Logo)" alt="" loading="lazy" />
                        }
                        <h3>@item.School</h3>
                        @if (!string.IsNullOrEmpty(item.Faculty))
                        {
                            <p class="birkan-muted">@item.Faculty</p>
                        }
                        @if (!string.IsNullOrEmpty(item.Department))
                        {
                            <p>@item.Department</p>
                        }
                    </li>
                }
            </ol>
        </div>
    </section>

    @if (hasExperience)
    {
        <section class="birkan-section" id="birkan-experience">
            <div class="birkan-shell">
                <div class="birkan-head" data-birkan-reveal>
                    <h2 class="birkan-title" data-birkan-split>@Model.Experience.Title</h2>
                    @if (!string.IsNullOrEmpty(Model.Experience.Description))
                    {
                        <p class="birkan-muted">@Model.Experience.Description</p>
                    }
                </div>
                <ol class="birkan-jobs" data-birkan-stagger>
                    @foreach (var job in Model.Experience.Items)
                    {
                        <li class="birkan-job" data-birkan-reveal>
                            <div class="birkan-job-side">
                                <p>@job.Start@(string.IsNullOrEmpty(job.End) ? "" : $" — {job.End}")</p>
                                @if (!string.IsNullOrEmpty(job.Location))
                                {
                                    <p class="birkan-muted">@job.Location</p>
                                }
                            </div>
                            <div class="birkan-job-main">
                                <div class="birkan-job-head">
                                    @if (!string.IsNullOrEmpty(BirkanSafe.MediaPath(job.Logo)))
                                    {
                                        <img class="birkan-job-logo" src="@BirkanSafe.MediaPath(job.Logo)" alt="" loading="lazy" />
                                    }
                                    <div>
                                        <h3>@job.Position</h3>
                                        <p class="birkan-muted">@job.Company</p>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(job.Description))
                                {
                                    <p>@job.Description</p>
                                }
                                @if (job.Highlights.Count > 0)
                                {
                                    <ul class="birkan-points">
                                        @foreach (var h in job.Highlights)
                                        {
                                            <li>@h</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </li>
                    }
                </ol>
            </div>
        </section>
    }

    <section class="birkan-section" id="birkan-skills">
        <div class="birkan-shell">
            <div class="birkan-head" data-birkan-reveal>
                <h2 class="birkan-title" data-birkan-split>@Model.Skills.Title</h2>
                <p class="birkan-muted">@Model.Skills.Description</p>
            </div>
            <ul class="birkan-skills" data-birkan-stagger>
                @foreach (var skill in Model.Skills.Items)
                {
                    <li>@skill.Name</li>
                }
            </ul>
        </div>
    </section>

    <section class="birkan-section birkan-section-tint" id="birkan-projects">
        <div class="birkan-shell">
            <div class="birkan-head" data-birkan-reveal>
                <h2 class="birkan-title" data-birkan-split>@Model.Projects.Title</h2>
                <p class="birkan-muted">@Model.Projects.Description</p>
            </div>
            <div class="birkan-projects" data-birkan-stagger>
                @for (var i = 0; i < Model.Projects.Items.Count; i++)
                {
                    var project = Model.Projects.Items[i];
                    <button class="birkan-project" type="button" data-birkan-open="birkan-project-@i" data-birkan-reveal>
                        <partial name="_BirkanProjectDrawing" model="i" />
                        <span class="birkan-project-badge">@project.Badge</span>
                        <span class="birkan-project-title">@project.Title</span>
                        <span class="birkan-project-excerpt">@project.Excerpt</span>
                        <span class="birkan-project-more">@project.Hint <span aria-hidden="true">→</span></span>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="birkan-contact" id="birkan-contact">
        <div class="birkan-shell birkan-contact-grid">
            <div data-birkan-reveal>
                <h2 class="birkan-title" data-birkan-split>@Model.Contact.Title</h2>
                <p class="birkan-contact-lead">@Model.Contact.Description</p>
            </div>
            <dl class="birkan-contact-list" data-birkan-reveal>
                @foreach (var item in Model.Contact.Items)
                {
                    var url = BirkanSafe.Url(item.Url);
                    <div>
                        <dt>@item.Label</dt>
                        <dd>
                            @if (!string.IsNullOrEmpty(url))
                            {
                                <a href="@url">@item.Value</a>
                            }
                            else
                            {
                                @item.Value
                            }
                        </dd>
                    </div>
                }
            </dl>
        </div>
        <footer class="birkan-shell birkan-footer">
            <span>© @DateTime.Now.Year @site.Name</span>
            <span>
                @foreach (var social in Model.Hero.Socials)
                {
                    <a href="@BirkanSafe.Url(social.Url)" target="_blank" rel="noopener noreferrer">@social.Label</a>
                }
            </span>
        </footer>
    </section>
</main>

@for (var i = 0; i < Model.Projects.Items.Count; i++)
{
    var project = Model.Projects.Items[i];
    <dialog class="birkan-drawer" id="birkan-project-@i" aria-labelledby="birkan-project-@i-title">
        <div class="birkan-drawer-inner">
            <div class="birkan-drawer-bar">
                <span class="birkan-project-badge">@project.Badge</span>
                <button class="birkan-drawer-close" type="button" data-birkan-close aria-label="Kapat">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9m0-9-9 9" /></svg>
                </button>
            </div>
            <h3 class="birkan-drawer-title" id="birkan-project-@i-title">@project.Title</h3>
            @if (!string.IsNullOrEmpty(BirkanSafe.MediaPath(project.Image)))
            {
                <img class="birkan-drawer-image" src="@BirkanSafe.MediaPath(project.Image)" alt="@project.Title" loading="lazy" />
            }
            <p class="birkan-drawer-intro">@project.Intro</p>
            @foreach (var block in project.Blocks)
            {
                <div class="birkan-drawer-block">
                    <h4>@block.Heading</h4>
                    <p>@block.Text</p>
                </div>
            }
            @if (project.Highlights.Count > 0)
            {
                <div class="birkan-drawer-block">
                    <h4>@project.ListTitle</h4>
                    <ul class="birkan-points">
                        @foreach (var h in project.Highlights)
                        {
                            <li>@h</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </dialog>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script src="~/js/birkan-site.js" asp-append-version="true"></script>
</body>
</html>
