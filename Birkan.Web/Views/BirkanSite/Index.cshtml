@model BirkanContent
@{
    var site = Model.Site;
    var hasExperience = Model.Experience.Items.Count > 0;

    var sections = new List<(string Id, string Label)>
    {
        ("birkan-about", site.Nav.About),
        ("birkan-education", site.Nav.Education)
    };
    if (hasExperience) sections.Add(("birkan-experience", site.Nav.Experience));
    sections.Add(("birkan-skills", site.Nav.Skills));
    sections.Add(("birkan-projects", site.Nav.Projects));
    sections.Add(("birkan-contact", site.Nav.Contact));

    var heroPhoto = BirkanSafe.MediaPath(Model.Hero.Photo);
    var aboutPhoto = BirkanSafe.MediaPath(Model.About.Photo);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@site.Title</title>
    <meta name="description" content="@site.MetaDescription" />
    <meta name="author" content="@site.Name" />
    <meta property="og:title" content="@site.Title" />
    <meta property="og:description" content="@site.MetaDescription" />
    <meta property="og:image" content="@heroPhoto" />
    <meta name="theme-color" content="#1b1d1f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/birkan-site.css" asp-append-version="true" />
</head>
<body>

<header class="birkan-navbar" id="birkan-navbar">
    <div class="birkan-shell birkan-navbar-inner">
        <a class="birkan-navbar-name" href="#birkan-home">@site.Name</a>
        <nav class="birkan-navbar-links" id="birkan-navbar-links" aria-label="Menü">
            <a href="#birkan-home" data-birkan-spy="birkan-home">@site.Nav.Home</a>
            @foreach (var s in sections)
            {
                <a href="#@s.Id" data-birkan-spy="@s.Id">@s.Label</a>
            }
        </nav>
        <button class="birkan-navbar-toggle" id="birkan-navbar-toggle" type="button" aria-controls="birkan-navbar-links" aria-expanded="false" aria-label="Menü">
            <span></span><span></span>
        </button>
    </div>
</header>

<main>
    <section class="birkan-hero" id="birkan-home">
        <div class="birkan-shell birkan-hero-inner">
            <div class="birkan-hero-text">
                <h1>@Model.Hero.Name</h1>
                <p class="birkan-hero-role">@site.Role</p>
                <p class="birkan-hero-intro">@Model.Hero.Text</p>
                @if (Model.Hero.Socials.Count > 0)
                {
                    <p class="birkan-hero-links">
                        @foreach (var social in Model.Hero.Socials)
                        {
                            <a class="birkan-link-button" href="@BirkanSafe.Url(social.Url)" target="_blank" rel="noopener noreferrer">@social.Label</a>
                        }
                    </p>
                }
            </div>
            <img class="birkan-hero-photo" src="@heroPhoto" alt="@Model.Hero.Name" width="360" height="450" />
        </div>
    </section>

    <section class="birkan-section" id="birkan-about">
        <div class="birkan-shell birkan-row">
            <h2 class="birkan-row-title">@Model.About.Title</h2>
            <div class="birkan-row-body">
                <div class="birkan-about">
                    <div>
                        <p class="birkan-about-greeting">@Model.About.Greeting <strong>@Model.About.GreetingName</strong></p>
                        <p>@Model.About.Bio</p>
                    </div>
                    @* Aynı fotoğraf girişte zaten büyük duruyor; burada yalnızca panelden farklı bir portre seçildiyse gösteriliyor. *@
                    @if (!string.IsNullOrEmpty(aboutPhoto) && aboutPhoto != heroPhoto)
                    {
                        <figure class="birkan-about-photo">
                            <img src="@aboutPhoto" alt="@site.Name" loading="lazy" />
                            <figcaption>@Model.About.BadgeTop @Model.About.BadgeBottom</figcaption>
                        </figure>
                    }
                </div>

                <h3 class="birkan-subtitle">@Model.About.ExpertiseTitle</h3>
                <p class="birkan-muted">@Model.About.ExpertiseDescription</p>
                <ul class="birkan-list birkan-list-2">
                    @foreach (var item in Model.About.Expertise)
                    {
                        <li>@item</li>
                    }
                </ul>
            </div>
        </div>
    </section>

    <section class="birkan-section" id="birkan-education">
        <div class="birkan-shell birkan-row">
            <h2 class="birkan-row-title">@Model.Education.Title</h2>
            <div class="birkan-row-body">
                @if (!string.IsNullOrEmpty(Model.Education.Description))
                {
                    <p class="birkan-muted">@Model.Education.Description</p>
                }
                <ul class="birkan-entries">
                    @foreach (var item in Model.Education.Items)
                    {
                        <li class="birkan-entry">
                            @if (!string.IsNullOrEmpty(BirkanSafe.MediaPath(item.Logo)))
                            {
                                <img class="birkan-entry-logo" src="@BirkanSafe.MediaPath(item.Logo)" alt="" loading="lazy" />
                            }
                            <div class="birkan-entry-main">
                                <h3>@item.School</h3>
                                @if (!string.IsNullOrEmpty(item.Faculty))
                                {
                                    <p>@item.Faculty</p>
                                }
                                @if (!string.IsNullOrEmpty(item.Department))
                                {
                                    <p>@item.Department</p>
                                }
                            </div>
                            <div class="birkan-entry-side">
                                <span>@item.Degree</span>
                                @if (!string.IsNullOrEmpty(item.Years))
                                {
                                    <span class="birkan-muted">@item.Years</span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </section>

    @if (hasExperience)
    {
        <section class="birkan-section" id="birkan-experience">
            <div class="birkan-shell birkan-row">
                <h2 class="birkan-row-title">@Model.Experience.Title</h2>
                <div class="birkan-row-body">
                    @if (!string.IsNullOrEmpty(Model.Experience.Description))
                    {
                        <p class="birkan-muted">@Model.Experience.Description</p>
                    }
                    <ul class="birkan-entries">
                        @foreach (var job in Model.Experience.Items)
                        {
                            <li class="birkan-entry">
                                @if (!string.IsNullOrEmpty(BirkanSafe.MediaPath(job.Logo)))
                                {
                                    <img class="birkan-entry-logo" src="@BirkanSafe.MediaPath(job.Logo)" alt="" loading="lazy" />
                                }
                                <div class="birkan-entry-main">
                                    <h3>@job.Position</h3>
                                    <p>@job.Company@(string.IsNullOrEmpty(job.Location) ? "" : $", {job.Location}")</p>
                                    @if (!string.IsNullOrEmpty(job.Description))
                                    {
                                        <p class="birkan-entry-text">@job.Description</p>
                                    }
                                    @if (job.Highlights.Count > 0)
                                    {
                                        <ul class="birkan-list">
                                            @foreach (var h in job.Highlights)
                                            {
                                                <li>@h</li>
                                            }
                                        </ul>
                                    }
                                </div>
                                <div class="birkan-entry-side">
                                    <span>@job.Start@(string.IsNullOrEmpty(job.End) ? "" : $" – {job.End}")</span>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </section>
    }

    <section class="birkan-section" id="birkan-skills">
        <div class="birkan-shell birkan-row">
            <h2 class="birkan-row-title">@Model.Skills.Title</h2>
            <div class="birkan-row-body">
                <p class="birkan-muted">@Model.Skills.Description</p>
                <ul class="birkan-tags">
                    @foreach (var skill in Model.Skills.Items)
                    {
                        <li>@skill.Name</li>
                    }
                </ul>
            </div>
        </div>
    </section>

    <section class="birkan-section" id="birkan-projects">
        <div class="birkan-shell birkan-row">
            <h2 class="birkan-row-title">@Model.Projects.Title</h2>
            <div class="birkan-row-body">
                <p class="birkan-muted">@Model.Projects.Description</p>
                <div class="birkan-projects">
                    @for (var i = 0; i < Model.Projects.Items.Count; i++)
                    {
                        var project = Model.Projects.Items[i];
                        <article class="birkan-project">
                            <p class="birkan-project-badge">@project.Badge</p>
                            <h3>@project.Title</h3>
                            <p>@project.Excerpt</p>
                            <button class="birkan-project-open" type="button" data-birkan-open="birkan-project-@i">@project.Hint</button>
                        </article>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="birkan-section birkan-contact" id="birkan-contact">
        <div class="birkan-shell birkan-row">
            <h2 class="birkan-row-title">@Model.Contact.Title</h2>
            <div class="birkan-row-body">
                <p>@Model.Contact.Description</p>
                <dl class="birkan-contact-list">
                    @foreach (var item in Model.Contact.Items)
                    {
                        var url = BirkanSafe.Url(item.Url);
                        <div>
                            <dt>@item.Label</dt>
                            <dd>
                                @if (!string.IsNullOrEmpty(url))
                                {
                                    <a href="@url">@item.Value</a>
                                }
                                else
                                {
                                    @item.Value
                                }
                            </dd>
                        </div>
                    }
                </dl>
            </div>
        </div>
    </section>
</main>

<footer class="birkan-footer">
    <div class="birkan-shell birkan-footer-inner">
        <span>© @DateTime.Now.Year @site.Name</span>
        <span>
            @foreach (var social in Model.Hero.Socials)
            {
                <a href="@BirkanSafe.Url(social.Url)" target="_blank" rel="noopener noreferrer">@social.Label</a>
            }
        </span>
    </div>
</footer>

@for (var i = 0; i < Model.Projects.Items.Count; i++)
{
    var project = Model.Projects.Items[i];
    <dialog class="birkan-dialog" id="birkan-project-@i" aria-labelledby="birkan-project-@i-title">
        <button class="birkan-dialog-close" type="button" data-birkan-close aria-label="Kapat">×</button>
        <p class="birkan-project-badge">@project.Badge</p>
        <h3 id="birkan-project-@i-title">@project.Title</h3>
        @if (!string.IsNullOrEmpty(BirkanSafe.MediaPath(project.Image)))
        {
            <img class="birkan-dialog-image" src="@BirkanSafe.MediaPath(project.Image)" alt="@project.Title" loading="lazy" />
        }
        <p>@project.Intro</p>
        @foreach (var block in project.Blocks)
        {
            <h4>@block.Heading</h4>
            <p>@block.Text</p>
        }
        @if (project.Highlights.Count > 0)
        {
            <h4>@project.ListTitle</h4>
            <ul class="birkan-list">
                @foreach (var h in project.Highlights)
                {
                    <li>@h</li>
                }
            </ul>
        }
    </dialog>
}

<script src="~/js/birkan-site.js" asp-append-version="true"></script>
</body>
</html>
