<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ef119e85-4914-4c22-9dbb-742b23262eee</UserSecretsId>
    <!-- Paylaşımlı hostingde uygulama havuzunun bellek sınırı düşük olabiliyor; sunucu GC'si açılışta büyük bellek
         ayırmaya çalışıp uygulamayı 500.30 ile düşürebiliyor. Tek kişilik bir site için iş istasyonu GC'si yeterli. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

</Project>
